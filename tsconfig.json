{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "incremental": true,
    "tsBuildInfoFile": "../Wohnungsplaner_Generated/cache/tsconfig.tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../Wohnungsplaner_Generated/build/next/types/**/*.ts",
    "../Wohnungsplaner_Generated/build/next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "../Wohnungsplaner_Generated",
    "node_modules",
    "dist",
    ".vinext",
    ".wrangler",
    ".next",
    "artifacts"
  ]
}
