{
  "name": "wohnungsplaner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --host 127.0.0.1 --port 3000 --strictPort",
    "build": "vinext build && node sync-client-assets.mjs",
    "start": "node serve-local.mjs",
    "start:vinext": "vinext start",
    "test:planner": "node --import tsx --test tests/planner-*.test.ts",
    "test:ui": "vitest run",
    "test:cutover": "node --test tests/rendered-html.test.mjs tests/planner-cutover.test.mjs && node scripts/check-client-bundle.mjs && node --test tests/serve-local.test.mjs",
    "test": "npm run build && npm run test:planner && npm run test:ui && npm run test:cutover",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "assets:check": "node scripts/check-planner-assets.mjs",
    "codex:preflight": "node scripts/codex-preflight.mjs",
    "codex:sync": "node scripts/codex-sync.mjs --mode=sync",
    "codex:reconcile": "node scripts/codex-pr-reconcile.mjs",
    "codex:build": "node scripts/codex-build.mjs",
    "codex:restart": "node scripts/codex-runtime.mjs --restart",
    "codex:agent:install": "node scripts/codex-agent.mjs install",
    "codex:agent:status": "node scripts/codex-agent.mjs status",
    "codex:agent:uninstall": "node scripts/codex-agent.mjs uninstall",
    "codex:postflight": "node scripts/codex-postflight.mjs",
    "codex:pipeline": "node scripts/codex-pipeline.mjs",
    "validate": "npm run typecheck && npm run lint && npm run assets:check && npm run test:planner && npm run test:ui && npm run test:cutover",
    "codex:update": "node scripts/codex-update.mjs",
    "codex:release": "node scripts/codex-release.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "konva": "10.9.0",
    "next": "16.4.3",
    "postprocessing": "6.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "three": "^0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "30.1.3",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vinext": "1.3.0",
    "vite": "8.0.13",
    "vitest": "5.0.5",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
