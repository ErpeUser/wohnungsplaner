{
  "name": "wohnungsplaner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1",
      "sharp": "0.35.5"
    },
    "satori": {
      "fflate": "0.8.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  },
  "scripts": {
    "prebuild": "node scripts/workspace-setup.mjs ensure",
    "postbuild": "node scripts/workspace-setup.mjs collect",
    "predev": "node scripts/workspace-setup.mjs ensure",
    "prestart": "node scripts/workspace-setup.mjs ensure",
    "pretest": "node scripts/workspace-setup.mjs ensure",
    "prevalidate": "node scripts/workspace-setup.mjs ensure",
    "pretypecheck": "node scripts/workspace-setup.mjs ensure",
    "prelint": "node scripts/workspace-setup.mjs ensure",
    "pretest:planner": "node scripts/workspace-setup.mjs ensure",
    "pretest:ui": "node scripts/workspace-setup.mjs ensure",
    "pretest:coverage": "node scripts/workspace-setup.mjs ensure",
    "pretest:cutover": "node scripts/workspace-setup.mjs ensure",
    "pretest:browser": "node scripts/workspace-setup.mjs ensure",
    "previsual:check": "node scripts/workspace-setup.mjs ensure",
    "previsual:models": "node scripts/workspace-setup.mjs ensure",
    "preassets:check": "node scripts/workspace-setup.mjs ensure",
    "prereference:check": "node scripts/workspace-setup.mjs ensure",
    "preprivacy:check": "node scripts/workspace-setup.mjs ensure",
    "predev:review": "node scripts/workspace-setup.mjs ensure",
    "workspace:prepare": "node scripts/workspace-setup.mjs ensure",
    "workspace:reset": "node scripts/workspace-setup.mjs install",
    "workspace:doctor": "node scripts/workspace-setup.mjs doctor",
    "workspace:inventory": "node scripts/workspace-inventory.mjs",
    "workspace:test": "node scripts/workspace-exec.mjs node --test tests/workspace-layout.test.mjs tests/git-policy.test.mjs",
    "workspace:browsers": "node scripts/workspace-setup.mjs browsers",
    "dev": "node scripts/workspace-exec.mjs vinext dev --host 127.0.0.1 --port 3000 --strictPort",
    "build": "node scripts/workspace-exec.mjs vinext build && node sync-client-assets.mjs",
    "start": "node scripts/workspace-exec.mjs node serve-local.mjs",
    "start:vinext": "node scripts/workspace-exec.mjs vinext start",
    "test:planner": "node scripts/workspace-exec.mjs node --import tsx --test tests/planner-*.test.ts",
    "test:ui": "node scripts/workspace-exec.mjs vitest run",
    "test:coverage": "node scripts/workspace-exec.mjs vitest run --coverage",
    "test:cutover": "node scripts/workspace-exec.mjs node --test --test-concurrency=1 tests/rendered-html.test.mjs tests/planner-cutover.test.mjs && node scripts/check-client-bundle.mjs && node scripts/workspace-exec.mjs node --test tests/serve-local.test.mjs",
    "test": "npm run build && npm run test:planner && npm run test:ui && npm run test:cutover",
    "typecheck": "node scripts/workspace-exec.mjs tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "node scripts/workspace-exec.mjs eslint . --ignore-pattern dist --ignore-pattern .next",
    "assets:check": "node scripts/workspace-exec.mjs node scripts/check-planner-assets.mjs",
    "validate": "npm run git:policy && npm run workspace:test && npm run typecheck && npm run lint && npm run assets:check && npm run test:planner && npm run test:ui && npm run test:cutover && npm run reference:check",
    "reference:check": "node scripts/workspace-exec.mjs node scripts/check-reference-exports.mjs",
    "test:browser": "node scripts/workspace-exec.mjs node scripts/visual-run.mjs gui",
    "visual:models": "node scripts/workspace-exec.mjs node scripts/visual-run.mjs models",
    "visual:check": "node scripts/workspace-exec.mjs node scripts/visual-run.mjs all",
    "dev:review": "node scripts/workspace-exec.mjs node scripts/visual-dev.mjs",
    "desktop:refresh": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/refresh-desktop-assets.ps1",
    "code:audit": "node scripts/code-audit.mjs",
    "security:prod": "node scripts/security-audit.mjs",
    "quality:check": "npm run git:policy && npm run workspace:test && npm run workspace:inventory && npm run code:audit && npm run security:prod && npm run privacy:check:strict",
    "privacy:check": "node scripts/workspace-exec.mjs node scripts/check-private-references.mjs",
    "privacy:check:strict": "node scripts/workspace-exec.mjs node scripts/check-private-references.mjs --strict",
    "git:policy": "node scripts/git-guard.mjs --verify",
    "github:setup": "node scripts/github-workflow.mjs setup",
    "github:status": "node scripts/github-workflow.mjs status",
    "github:sync": "node scripts/github-workflow.mjs sync",
    "github:reconcile": "node scripts/github-workflow.mjs reconcile",
    "github:audit": "node scripts/github-workflow.mjs reconcile"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "konva": "10.9.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "three": "^0.186.1",
    "three-stdlib": "2.36.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "30.1.3",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vinext": "1.3.0",
    "vite": "^8.3.8",
    "vitest": "5.0.5",
    "wrangler": "^4.160.0"
  },
  "type": "module"
}
