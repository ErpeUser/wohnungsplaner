#!/bin/sh
# No branch copies or unreviewed pushes. GitHub independently repeats quality checks.
set -eu
cd "$(git rev-parse --show-toplevel)"
push_refs=$(cat)
printf '%s\n' "$push_refs" | node scripts/git-guard.mjs --pre-push
printf '%s\n' "$push_refs" | node scripts/pre-push-check.mjs
node scripts/git-guard.mjs --verify
